{
  "name": "lingkuang",
  "productName": "灵框 LingKuang",
  "version": "3.0.0",
  "description": "灵框 · 阈限梦核世界观工作台",
  "main": "main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "vite build && electron .",
    "dev:electron": "vite build && electron .",
    "dist": "electron-builder --win",
    "pack": "electron-builder --dir"
  },
  "author": "fu-dingyong",
  "license": "GPL-3.0",
  "build": {
    "appId": "com.lingkuang.app",
    "productName": "灵框 LingKuang",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "lingkuang.js",
      "index.html",
      "mcp-server.js",
      "package.json",
      "data/character_lib.json",
      "data/worldbuilding.js",
      "design-system/**/*"
    ],
    "asar": true,
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "LingKuang-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "灵框"
    },
    "portable": {
      "artifactName": "LingKuang-${version}-portable-${arch}.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@tiptap/core": "^3.30.2",
    "@tiptap/markdown": "^3.30.2",
    "@tiptap/pm": "^3.30.2",
    "@tiptap/starter-kit": "^3.30.2",
    "markdown-it": "^15.0.0",
    "zod": "^4.4.3"
  }
}
